rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // قواعد مفتوحة: التطبيق يدير الحسابات والصلاحيات بنفسه (بدون Firebase Authentication).
    // لا تستعمل قواعد الاختبار ذات تاريخ الانتهاء، لأن التطبيق سيتوقف عند انتهائها.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
